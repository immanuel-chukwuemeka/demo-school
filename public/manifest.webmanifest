  "shortcuts": [
    {
      "name": "Admissions",
      "short_name": "Admissions",
      "description": "Start an admission application",
      "url": "./admissions.html",
      "icons": [
        {
          "src": "assets/icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Check Result",
      "short_name": "Check Result",
      "description": "Parents: check a child's result with a scratch card",
      "url": "./check-result.html",
      "icons": [
        {
          "src": "assets/icons/icon-96.png",
          "sizes": "96x96",

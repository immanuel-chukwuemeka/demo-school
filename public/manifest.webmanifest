{
  "name": "Greenwood Academy International",
  "short_name": "Greenwood",
  "description": "Greenwood Academy International — a premium Nigerian private school from Creche to Secondary. Admissions, requirements, results and school news, installable as an app.",
  "lang": "en-NG",
  "dir": "ltr",
  "id": "greenwood-academy",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "theme_color": "#0D1B2A",
  "background_color": "#FFFFFF",
  "categories": [
    "education",
    "productivity"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },

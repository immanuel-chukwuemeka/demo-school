# =============================================================
# FIREBASE WEB CONFIG (client side - SAFE to expose)
# These are NOT secrets. They identify the Firebase app in the
# browser. Copy this file to `.env` and fill in your values.
# The public website only ever uses these values.
# =============================================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# -------------------------------------------------------------
# FIREBASE ADMIN / SERVER-ONLY (NEVER expose, NEVER commit)
# Used ONLY by server scripts in /server (seeding etc.).
# The private key ships INSIDE server/serviceAccountKey.json.
# Copy `.env.server` -> your own machine only.
# -------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=